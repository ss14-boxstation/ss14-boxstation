acolyte-role-greeting-human =
    You are an Acolyte, someone who has magical powers.
    You are here to collect magical materials.
    Your amulet lets you cast spells, do not lose it.

objective-issuer-acolyte = [color=#ae00f5]Gather[/color]

acolyte-round-end-name = Acolyte

acolyte-round-end-agent-name = Acolyte

soul-harvest-popup-start = {CAPITALIZE(THE($harvested))} starts to lift into the air as their soul starts to leave their body.
soul-harvest-popup-end = {CAPITALIZE(THE($harvester))} grabs a piece of {CAPITALIZE(THE($harvested))}'s soul and the {CAPITALIZE(THE($harvested))}'s body falls down to the floor.
