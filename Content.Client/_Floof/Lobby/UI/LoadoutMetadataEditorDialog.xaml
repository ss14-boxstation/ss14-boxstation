<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="400, 300">

    <BoxContainer
        Orientation="Vertical"
        Margin="8">

        <!--<BoxContainer Name="LoadoutPreviewContainer" Orientation="Vertical"/> --><!-- Populated in constructor, shows a preview -->
        <SpriteView Name="Sprite" Scale="4 4" MouseFilter="Stop"/> <!-- Just show a sprite instead of a full LoadoutContainer-->

        <controls:HLine Color="#404040" Thickness="2" Margin="0 5" />

        <BoxContainer Orientation="Vertical" Margin="2 0">
            <Label Text="{Loc 'box-loadout-metadata-editor-custom-name'}"></Label> <!-- Box Change - Use our strings -->
            <LineEdit
                Name="CustomNameField"
                PlaceHolder="{Loc 'box-loadout-metadata-editor-empty-hint'}"
                ToolTip="{Loc 'box-loadout-metadata-editor-custom-name-tooltip'}"/> <!-- Box Change - Use our strings -->

            <Label Text="{Loc 'box-loadout-metadata-editor-custom-desc'}"></Label> <!-- Box Change - Use our strings -->
            <LineEdit
                Name="CustomDescField" 
                PlaceHolder="{Loc 'box-loadout-metadata-editor-empty-hint'}"
                ToolTip="{Loc 'box-loadout-metadata-editor-custom-name-tooltip'}"/> <!-- Box Change - Use our strings -->

        </BoxContainer>

        <controls:HLine Color="#404040" Thickness="2" Margin="0 5" />

        <!-- I took this from QuickDialog, sue me -->
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="SaveButton" Text="{Loc 'quick-dialog-ui-ok'}"/>
            <Button Name="CancelButton" Text="{Loc 'quick-dialog-ui-cancel'}"/>
        </BoxContainer>
    </BoxContainer>

</controls:FancyWindow>
